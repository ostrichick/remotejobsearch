# RoleScout 환경 변수
# 로컬 개발: 이 파일을 .env 에 복사하거나 wrangler 변수로 설정하세요.

# --- API (옵션) ---
# AI 의미 분석에 사용하며, 연결 전에는 값이 없어도 됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 사용량 제한 (옵션, 기본값 사용 시 비워도 됨) ---
# 일일 분석 횟수 제한 (기본 30)
ANALYZE_DAILY_LIMIT=30
# 일일 검색 횟수 제한 (기본 50)
SEARCH_DAILY_LIMIT=50
# 최대 요청 본문 크기 (바이트, 기본 6000000)
MAX_BODY_BYTES=6000000