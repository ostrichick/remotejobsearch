{
  "name": "remote-job-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "node scripts/clean-build.mjs && tsc --noEmit && vite build --config vite.config.ts && esbuild server/worker.ts --bundle --format=esm --platform=browser --outfile=dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply rolescout-local --local",
    "preview": "vite preview"
  },
  "dependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@vitejs/plugin-react": "latest",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "wrangler": "^4.129.1"
  }
}
